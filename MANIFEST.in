include uv.lock
include .python-version
include LICENSE NOTICE CITATION.cff CONTRIBUTING.md SECURITY.md CHANGELOG.md
recursive-include docs *.md *.json
recursive-include scripts *.py
recursive-include tests *.py
global-exclude *.py[cod]
global-exclude .DS_Store
recursive-include experiments *.json
recursive-include evidence *.md *.json *.jsonl *.csv *.svg *.png
